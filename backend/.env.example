# Copy to .env and edit. NEVER commit .env
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string-32chars+
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Dev only: return the reset token in the forgot-password response
EXPOSE_RESET_TOKEN=true

# ---- Razorpay (keep sandbox and live strictly separate) ----
RAZORPAY_MODE=sandbox
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
# Webhook secrets (Razorpay dashboard > Webhooks). URL: https://YOUR-BACKEND/api/payments/webhook
RAZORPAY_TEST_WEBHOOK_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=
# If test keys are empty, a local MOCK gateway is used (sandbox mode only)

# ---- Email (optional; emails are only logged if MAIL_SERVER is empty) ----
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=no-reply@shopsphere.local
